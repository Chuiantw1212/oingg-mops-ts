// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Define the database connection
datasource db {
  // You can use "mysql", "sqlite", "sqlserver", "mongodb"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2. Define the Prisma Client generator
generator client {
  provider = "prisma-client-js"
}

// 3. Define your data models
model IncomeStatement {
  id        Int      @id @default(autoincrement())
  companyId String // 股票代號
  year      Int // 年度
  quarter   Int // 季度
  data      Json // 完整的損益表 JSON 資料
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, year, quarter]) // 確保每個公司在特定時間點的報告是唯一的
}