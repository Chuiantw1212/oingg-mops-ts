generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 公發公司單季損益表，由 /api/ingest/income-statements 觸發向 MOPS 抓取並解析匯入。
model QuarterlyIncomeStatement {
  symbol              String
  year                Int
  quarter             Int
  /// '1' = 個體, '2' = 合併
  dataType            String @map("data_type")
  /// 子公司代號；查詢母公司本身時為空字串
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime @map("report_date") @db.Date

  // --- 營業毛利 ---
  operatingRevenue            BigInt? @map("operating_revenue") // 營業收入合計
  operatingCost               BigInt? @map("operating_cost") // 營業成本合計
  grossProfitBeforeAdjustment BigInt? @map("gross_profit_before_adjustment") // 營業毛利（毛損）
  grossProfit                 BigInt? @map("gross_profit") // 營業毛利（毛損）淨額

  // --- 營業費用 ---
  sellingExpenses           BigInt? @map("selling_expenses") // 推銷費用
  adminExpenses             BigInt? @map("admin_expenses") // 管理費用
  rdExpenses                BigInt? @map("rd_expenses") // 研究發展費用
  operatingExpenses         BigInt? @map("operating_expenses") // 營業費用合計
  otherOperatingGainsLosses BigInt? @map("other_operating_gains_losses") // 其他收益及費損淨額
  operatingIncome           BigInt? @map("operating_income") // 營業利益（損失）

  // --- 營業外收支 ---
  interestIncome               BigInt? @map("interest_income") // 利息收入
  otherIncome                  BigInt? @map("other_income") // 其他收入
  otherNonOperatingGainsLosses BigInt? @map("other_non_operating_gains_losses") // 其他利益及損失淨額
  financeCosts                 BigInt? @map("finance_costs") // 財務成本淨額
  shareOfAssociatesJvProfit    BigInt? @map("share_of_associates_jv_profit") // 採用權益法認列之關聯企業及合資損益之份額淨額
  nonOperatingIncomeExpenses   BigInt? @map("non_operating_income_expenses") // 營業外收入及支出合計

  // --- 稅前/稅後淨利 ---
  profitBeforeTax            BigInt? @map("profit_before_tax") // 稅前淨利（淨損）
  incomeTaxExpense           BigInt? @map("income_tax_expense") // 所得稅費用（利益）合計
  netIncomeFromContinuingOps BigInt? @map("net_income_from_continuing_ops") // 繼續營業單位本期淨利（淨損）
  netIncome                  BigInt? @map("net_income") // 本期淨利（淨損）

  // --- 綜合損益 ---
  otherComprehensiveIncome BigInt? @map("other_comprehensive_income") // 其他綜合損益（淨額）
  totalComprehensiveIncome BigInt? @map("total_comprehensive_income") // 本期綜合損益總額

  // --- 損益歸屬 ---
  netIncomeAttributableToParent           BigInt? @map("net_income_attributable_to_parent") // 母公司業主（淨利/損）
  netIncomeAttributableToNci              BigInt? @map("net_income_attributable_to_nci") // 非控制權益（淨利/損）
  comprehensiveIncomeAttributableToParent BigInt? @map("comprehensive_income_attributable_to_parent") // 母公司業主（綜合損益）
  comprehensiveIncomeAttributableToNci    BigInt? @map("comprehensive_income_attributable_to_nci") // 非控制權益（綜合損益）

  // --- 每股盈餘 ---
  eps        Decimal? @map("eps") @db.Decimal(10, 2) // 基本每股盈餘
  epsDiluted Decimal? @map("eps_diluted") @db.Decimal(10, 2) // 稀釋每股盈餘

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, quarter, dataType, subsidiaryCompanyId])
  @@map("quarterly_income_statement")
}

/// 公發公司單季資產負債表，由 /api/ingest/balance-sheets 觸發向 MOPS 抓取並解析匯入。
model QuarterlyBalanceSheet {
  symbol              String
  year                Int
  quarter             Int
  /// '1' = 個體, '2' = 合併
  dataType            String @map("data_type")
  /// 子公司代號；查詢母公司本身時為空字串
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime @map("report_date") @db.Date

  // --- 資產 ---
  cashAndEquivalents           BigInt? @map("cash_and_equivalents") // 現金及約當現金
  accountsReceivable           BigInt? @map("accounts_receivable") // 應收帳款淨額
  inventory                    BigInt? @map("inventory") // 存貨
  currentAssets                BigInt? @map("current_assets") // 流動資產合計
  propertyPlantEquipment       BigInt? @map("property_plant_equipment") // 不動產、廠房及設備
  investmentsUnderEquityMethod BigInt? @map("investments_under_equity_method") // 採用權益法之投資
  intangibleAssets             BigInt? @map("intangible_assets") // 無形資產
  nonCurrentAssets             BigInt? @map("non_current_assets") // 非流動資產合計
  totalAssets                  BigInt? @map("total_assets") // 資產總額

  // --- 負債 ---
  shortTermBorrowings   BigInt? @map("short_term_borrowings") // 短期借款
  accountsPayable       BigInt? @map("accounts_payable") // 應付帳款
  currentLiabilities    BigInt? @map("current_liabilities") // 流動負債合計
  bondsPayable          BigInt? @map("bonds_payable") // 應付公司債
  longTermBorrowings    BigInt? @map("long_term_borrowings") // 長期借款
  nonCurrentLiabilities BigInt? @map("non_current_liabilities") // 非流動負債合計
  totalLiabilities      BigInt? @map("total_liabilities") // 負債總額

  // --- 權益 ---
  capitalStock               BigInt? @map("capital_stock") // 股本合計
  capitalSurplus             BigInt? @map("capital_surplus") // 資本公積合計
  retainedEarnings           BigInt? @map("retained_earnings") // 保留盈餘合計
  otherEquity                BigInt? @map("other_equity") // 其他權益合計
  treasuryStock              BigInt? @map("treasury_stock") // 庫藏股票
  equityAttributableToParent BigInt? @map("equity_attributable_to_parent") // 歸屬於母公司業主之權益合計
  nonControllingInterest     BigInt? @map("non_controlling_interest") // 非控制權益
  totalEquity                BigInt? @map("total_equity") // 權益總額
  totalLiabilitiesAndEquity  BigInt? @map("total_liabilities_and_equity") // 負債及權益總計

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, quarter, dataType, subsidiaryCompanyId])
  @@map("quarterly_balance_sheet")
}

/// 公發公司單季現金流量表，由 /api/ingest/cash-flow-statements 觸發向 MOPS 抓取並解析匯入。
/// 注意：金額欄位是 MOPS 原始回傳的「累計」數（例如 Q2 為當年 1/1~6/30 累計），不是單季數字。
model QuarterlyCashFlowStatement {
  symbol              String
  year                Int
  quarter             Int
  /// '1' = 個體, '2' = 合併
  dataType            String @map("data_type")
  /// 子公司代號；查詢母公司本身時為空字串
  subsidiaryCompanyId String @default("") @map("subsidiary_company_id")

  reportDate DateTime @map("report_date") @db.Date

  // --- 營業活動 ---
  profitBeforeTax                BigInt? @map("profit_before_tax") // 本期稅前淨利（淨損）
  depreciation                   BigInt? @map("depreciation") // 折舊費用
  amortization                   BigInt? @map("amortization") // 攤銷費用
  adjustmentsTotal               BigInt? @map("adjustments_total") // 調整項目合計
  cashGeneratedFromOperations    BigInt? @map("cash_generated_from_operations") // 營運產生之現金流入（流出）
  incomeTaxPaid                  BigInt? @map("income_tax_paid") // 退還（支付）之所得稅
  netCashFromOperatingActivities BigInt? @map("net_cash_from_operating_activities") // 營業活動之淨現金流入（流出）

  // --- 投資活動 ---
  capitalExpenditures            BigInt? @map("capital_expenditures") // 取得不動產、廠房及設備
  proceedsFromDisposalOfPpe      BigInt? @map("proceeds_from_disposal_of_ppe") // 處分不動產、廠房及設備
  acquisitionOfIntangibleAssets  BigInt? @map("acquisition_of_intangible_assets") // 取得無形資產
  interestReceived               BigInt? @map("interest_received") // 收取之利息
  dividendsReceived              BigInt? @map("dividends_received") // 收取之股利
  netCashFromInvestingActivities BigInt? @map("net_cash_from_investing_activities") // 投資活動之淨現金流入（流出）

  // --- 籌資活動 ---
  proceedsFromBondsIssued        BigInt? @map("proceeds_from_bonds_issued") // 發行公司債
  repaymentOfBonds               BigInt? @map("repayment_of_bonds") // 償還公司債
  proceedsFromLongTermBorrowings BigInt? @map("proceeds_from_long_term_borrowings") // 舉借長期借款
  repaymentOfLongTermBorrowings  BigInt? @map("repayment_of_long_term_borrowings") // 償還長期借款
  dividendsPaid                  BigInt? @map("dividends_paid") // 發放現金股利
  interestPaid                   BigInt? @map("interest_paid") // 支付之利息
  netCashFromFinancingActivities BigInt? @map("net_cash_from_financing_activities") // 籌資活動之淨現金流入（流出）

  // --- 匯率影響與現金餘額 ---
  exchangeRateEffect   BigInt? @map("exchange_rate_effect") // 匯率變動對現金及約當現金之影響
  netIncreaseInCash    BigInt? @map("net_increase_in_cash") // 本期現金及約當現金增加（減少）數
  cashBeginningBalance BigInt? @map("cash_beginning_balance") // 期初現金及約當現金餘額
  cashEndingBalance    BigInt? @map("cash_ending_balance") // 期末現金及約當現金餘額（IAS 7 現金流量表口徑，金融業會比資產負債表範圍更廣）
  /// 資產負債表帳列之現金及約當現金——對應資產負債表口徑，三表勾稽應以此欄位比對資產負債表，而非 cashEndingBalance
  cashPerBalanceSheet  BigInt? @map("cash_per_balance_sheet")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, year, quarter, dataType, subsidiaryCompanyId])
  @@map("quarterly_cash_flow_statement")
}

/// 公司股本變更歷史，由 /api/ingest/capital-stock-history 觸發向 MOPS t05st05（資本形成經過，非官方 HTML 端點，
/// 見規格文件）抓取並解析匯入。每一列代表一次「變更公司執照」時的申報存檔（快照式歷史，不是季度資料）。
model CapitalStockHistory {
  symbol String

  /// 生效年月（西元），來自 Step1 清單 onclick 的 year.value/month.value，比民國年文字解析更穩定，作為主鍵一部分
  effectiveYear  Int @map("effective_year")
  effectiveMonth Int @map("effective_month")

  /// 變更公司執照時間（民國年/月），來自 Step2 明細表格文字，僅供顯示用，不作為主鍵
  licenseChangeYear  Int? @map("license_change_year")
  licenseChangeMonth Int? @map("license_change_month")

  /// TYPEK：sii=上市, otc=上櫃, rotc=興櫃(未驗證), pub=公開發行(未驗證)
  market String? @map("market")

  parValue          Decimal? @map("par_value") @db.Decimal(10, 4) // 每股面額
  authorizedShares  BigInt?  @map("authorized_shares") // 核定股本股數
  authorizedCapital BigInt?  @map("authorized_capital") // 核定股本金額
  paidInShares      BigInt?  @map("paid_in_shares") // 實收股本股數
  /// 實收股本金額（元）＝財報上的「股本」，本表主要目標欄位，每一筆都是該時點的期末餘額（非增量）
  paidInCapital     BigInt?  @map("paid_in_capital")

  // --- 股本來源（注意：每家公司最早一筆為累計數，第二筆起為該次異動的增量，見規格文件 §2 解析規則第4點） ---
  sourceInitialCapital           BigInt? @map("source_initial_capital") // 1.創立時資本
  sourceCashIncrease             BigInt? @map("source_cash_increase") // 2.現金增資
  sourceCapitalReserveTransfer   BigInt? @map("source_capital_reserve_transfer") // 3.資本公積轉增資
  sourceRetainedEarningsTransfer BigInt? @map("source_retained_earnings_transfer") // 4.盈餘轉增資
  capitalReserveApprovalDate     String? @map("capital_reserve_approval_date") // 5.證期局核准資本公積之日期
  retainedEarningsApprovalDate   String? @map("retained_earnings_approval_date") // 6.證期局核准盈餘轉增資之日期
  sourceMergerIncrease           BigInt? @map("source_merger_increase") // 7.合併增資
  sourceCapitalReduction         BigInt? @map("source_capital_reduction") // 8.減資
  mergerApprovalDate             String? @map("merger_approval_date") // 9.證期局核准合併增資之日期
  capitalReductionApprovalDate   String? @map("capital_reduction_approval_date") // 10.證期局核准減資之日期
  sourceOther                    String? @map("source_other") // 11.其他

  nonCashContribution String? @map("non_cash_contribution") // 以現金以外之財產抵充股款者
  remarks              String? @map("remarks") // 其他（備註）

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, effectiveYear, effectiveMonth])
  @@map("capital_stock_history")
}

/// 公司股利分派公告資料，由 /api/ingest/dividend-distributions 觸發向 MOPS t108sb27（非官方 HTML 端點）抓取並解析匯入。
/// 只涵蓋回應中「適用停止過戶期間規定之公司」表格；「不適用...」表格欄位配置尚未驗證，見 dividend/parser.ts 說明。
model DividendDistribution {
  symbol            String
  rightsRecordDate  DateTime @map("rights_record_date") @db.Date // 權利分派基準日

  companyName    String? @map("company_name")
  /// 股利所屬期間拆成的民國年（原本是「113年第3季」這樣的合併文字，見 dividend/parser.ts 說明）
  fiscalYear    Int? @map("fiscal_year")
  /// 股利所屬期間拆成的季別（1-4）；只在格式是常見的「NNN年第M季」時解析得到，其他格式（年度/半年度股利等）為 null
  fiscalQuarter Int? @map("fiscal_quarter")

  stockDividendFromEarnings       Decimal?  @map("stock_dividend_from_earnings") @db.Decimal(12, 8) // 盈餘轉增資配股(元/股)
  stockDividendFromCapitalReserve Decimal?  @map("stock_dividend_from_capital_reserve") @db.Decimal(12, 8) // 法定盈餘公積、資本公積轉增資配股(元/股)
  exRightsDate                    DateTime? @map("ex_rights_date") @db.Date // 除權交易日

  cashDividendFromEarnings       Decimal?  @map("cash_dividend_from_earnings") @db.Decimal(12, 8) // 盈餘分配之股東現金股利(元/股)
  cashDividendFromCapitalReserve Decimal?  @map("cash_dividend_from_capital_reserve") @db.Decimal(12, 8) // 法定盈餘公積、資本公積發放之現金(元/股)
  preferredStockCashDividend     Decimal?  @map("preferred_stock_cash_dividend") @db.Decimal(12, 8) // 特別股配發現金股利(元/股)
  exDividendDate                  DateTime? @map("ex_dividend_date") @db.Date // 除息交易日
  cashDividendPaymentDate         DateTime? @map("cash_dividend_payment_date") @db.Date // 現金股利發放日

  capitalIncreaseShares            BigInt?  @map("capital_increase_shares") // 現金增資總股數(股)
  capitalIncreaseSubscriptionRatio Decimal? @map("capital_increase_subscription_ratio") @db.Decimal(8, 4) // 現金增資認股比率(%)
  capitalIncreaseSubscriptionPrice Decimal? @map("capital_increase_subscription_price") @db.Decimal(10, 4) // 現金增資認購價(元/股)

  totalParticipatingShares BigInt? @map("total_participating_shares") // 參加分派總股數

  announcementDate DateTime? @map("announcement_date") @db.Date // 公告日期
  announcementTime String?   @map("announcement_time") // 公告時間（僅時分秒，不併入 announcementDate）

  parValue Decimal? @map("par_value") @db.Decimal(10, 4) // 普通股每股面額，從「新台幣10.0000元」這類文字抽取數字

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([symbol, rightsRecordDate])
  @@map("dividend_distribution")
}
